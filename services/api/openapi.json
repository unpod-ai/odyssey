    "/metrics": {
      "get": {
        "description": "A snapshot missing `MetricsSnapshotOut`'s required fields (older\nprobe payloads predate ``ts``/``os`` being sent on every snapshot) is\nskipped rather than 500ing the whole listing \u2014 the same\n\"malformed entries don't take down the rest\" defensiveness\n`domain.list_metrics` already applies to unparseable JSON lines.\n``?product=<slug>`` narrows to one product's ``metrics/`` directory,\nsame filter `/journeys` supports.",
        "operationId": "list_metrics_metrics_get",
        "parameters": [
          {
            "in": "query",
            "name": "product",
            "required": false,
            "schema": {
              "anyOf": [
