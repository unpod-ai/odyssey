# --- Artifact directories: git tracks the recipe and the hash, the store holds the bytes.
#     Directory survives via .gitkeep; contents never enter history. See docs/adr/0002.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

training/checkpoints/*
!training/checkpoints/.gitkeep
training/logs/*
!training/logs/.gitkeep
training/outputs/*
!training/outputs/.gitkeep

models/pretrained/*
!models/pretrained/.gitkeep
models/finetuned/*
!models/finetuned/.gitkeep
models/exported/*
!models/exported/.gitkeep

evaluation/reports/*
!evaluation/reports/.gitkeep
!evaluation/reports/templates/
