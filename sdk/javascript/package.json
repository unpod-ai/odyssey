{
  "name": "@odyssey/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "Generated TypeScript client for services/api (item 8.5) — the JS twin of sdk/python.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:check": "tsx scripts/codegen.ts --check"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
